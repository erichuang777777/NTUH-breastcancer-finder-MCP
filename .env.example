# Copy to patient.env or .env and fill locally. Never commit real values.
# PATIENT_ID is a Taiwan national ID / chart number. Do not hardcode it in the repo.
PATIENT_ID=
PATIENT_BIRTHDATE=
# Optional
# PATIENT_NAME=
# PATIENT_PHONE=
# PATIENT_ID_TYPE=personID

# SQLite roster (default: data/ntuh.db)
# NTUH_DB=

# Real WebReg POST stays off. Set to 1 only when you intend to submit.
NTUH_REG_AUTOSUBMIT=0
REG_AUTOSUBMIT=0

# Optional campus override: T0 | CH | C0 | T4 | T7 | Y0
# NTUH_REG_HOSP_CODE=
# NTUH_RECAPTCHA_TOKEN=
